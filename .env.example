# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Realsee Open Platform (optional for MVP)
REALSEE_API_KEY=your-realsee-api-key
REALSEE_BASE_URL=https://open-platform.realsee.com

# Python environment
PYTHON_PATH=python
PYTHON_SERVICE_PORT=8765

# Ads Platform（看广告赚 Token 积分）
ADS_PORT=3099
ADS_HOST=127.0.0.1

# Lootably offerwall
LOOTABLY_OFFERWALL_URL=https://wall.lootably.com/?apiKey=YOUR_API_KEY&userId=
LOOTABLY_SECRET=your_lootably_secret

# AdGate offerwall（可选）
ADGATE_WALL_URL=https://wall.adgaterewards.com/YOUR_CAMPAIGN
ADGATE_SECRET=your_adgate_secret

# AdGem offerwall（可选）
ADGEM_WALL_URL=https://adgem.com/wall/YOUR_APP
ADGEM_SECRET=your_adgem_secret
